        },
        {
          "key": "Shift+→",
          "desc": "移动",
          "raw": "alias SRight \"move; ipick_to_gridunit +1\"",
          "source": "default"
        },
        {
          "key": "Shift+↓",
          "desc": "移动",
          "raw": "alias SDown \"move; ipick_to_gridunit 0 -1\"",
          "source": "default"
        },
        {
          "key": "Shift+F5",
          "desc": "复制",
          "raw": "alias SF5 copy",
          "source": "default"
        },
        {
          "key": "Shift+F6",
          "desc": "移动",
          "raw": "alias SF6 move",
          "source": "default"
        },
        {
          "key": "Shift+F9",
          "desc": "编辑顶点",
          "raw": "alias SF9 vertex",
          "source": "default"
        }
      ]
    },
    {
      "name": "查询",
      "pinned": false,
      "items": [
        {
          "key": "F4",
