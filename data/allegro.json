        },
        {
          "key": "Ctrl+B",
          "desc": "settoggle shove_mode Off …",
          "raw": "alias ~B bubset",
          "source": "default"
        },
        {
          "key": "Ctrl+←",
          "desc": "增量拾取（0）",
          "raw": "alias CLeft \"ipick 0; ipick_to_gridunit -1\"",
          "source": "default"
        },
        {
          "key": "Ctrl+↑",
          "desc": "增量拾取（0）",
          "raw": "alias CUp \"ipick 0; ipick_to_gridunit 0 +1\"",
          "source": "default"
        },
        {
          "key": "Ctrl+→",
          "desc": "增量拾取（0）",
          "raw": "alias CRight \"ipick 0; ipick_to_gridunit +1\"",
          "source": "default"
        },
        {
          "key": "Ctrl+↓",
          "desc": "增量拾取（0）",
          "raw": "alias CDown \"ipick 0; ipick_to_gridunit 0 -1\"",
          "source": "default"
        },
        {
          "key": "Ctrl+F2",
          "desc": "选择下一项",
          "raw": "alias CF2 next",
          "source": "default"
        },
        {
          "key": "Ctrl+F6",
          "desc": "层优先级",
          "raw": "alias CF6 layer priority",
          "source": "default"
        },
        {
          "key": "Ctrl+Shift+B",
          "desc": "settoggle smooth_mode Off…",
          "raw": "alias ~SB smoothset",
          "source": "default"
        }
      ]
    }
  ]
