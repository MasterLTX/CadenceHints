          "source": "default"
        },
        {
          "key": "Ctrl+D",
          "desc": "删除",
          "raw": "alias ~D delete",
          "source": "default"
        },
        {
          "key": "Ctrl+Y",
          "desc": "重做",
          "raw": "alias ~Y redo",
          "source": "default"
        },
        {
