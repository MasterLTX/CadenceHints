        },
        {
          "key": "Shift+F7",
          "desc": "取消高亮",
          "raw": "alias SF7 dehilight",
          "source": "default"
        },
        {
          "key": "Shift+F8",
          "desc": "高亮所选",
          "raw": "alias SF8 hilight pick",
          "source": "default"
        },
        {
          "key": "Ctrl+Shift+F5",
          "desc": "查看状态",
          "raw": "alias CSF5 status",
          "source": "default"
        }
      ]
    },
    {
      "name": "文件",
      "pinned": false,
      "items": [
        {
          "key": "Ctrl+N",
          "desc": "新建",
          "raw": "alias ~N new",
          "source": "default"
        },
        {
          "key": "Ctrl+O",
          "desc": "打开",
          "raw": "alias ~O open",
          "source": "default"
        },
        {
          "key": "Ctrl+S",
          "desc": "保存",
          "raw": "alias ~S save",
          "source": "default"
        },
        {
          "key": "Shift+F10",
          "desc": "临时另存",
          "raw": "alias SF10 save_as temp",
          "source": "default"
        }
      ]
    },
    {
      "name": "操作",
      "pinned": false,
      "items": [
        {
          "key": "x",
          "desc": "拾取点",
          "raw": "alias x pick",
          "source": "default"
        },
        {
          "key": "y",
          "desc": "拾取相对点",
          "raw": "alias y pick l",
          "source": "default"
        },
        {
