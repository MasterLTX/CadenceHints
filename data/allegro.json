{
  "tool": "allegro",
  "title": "Allegro PCB Editor",
  "sections": [
    {
      "name": "布线",
      "pinned": true,
      "items": [
        {
          "key": "F3",
          "desc": "布线",
          "raw": "alias F3 add connect",
          "source": "default"
        },
        {
          "key": "Shift+F3",
          "desc": "推挤/滑线",
          "raw": "alias SF3 slide",
          "source": "default"
        }
      ]
    },
    {
      "name": "视图",
      "pinned": true,
      "items": [
        {
          "key": "-",
          "desc": "上一子类",
          "raw": "funckey - subclass --",
          "source": "default"
        },
        {
          "key": "←",
          "desc": "平移视图 x-",
          "raw": "funckey Left \"roam x -$roamInc\"",
          "source": "default"
        },
        {
          "key": "↑",
          "desc": "平移视图 y-",
          "raw": "funckey Up \"roam y -$roamInc\"",
          "source": "default"
        },
        {
          "key": "→",
          "desc": "平移视图 x+",
          "raw": "funckey Right \"roam x $roamInc\"",
          "source": "default"
        },
        {
          "key": "↓",
          "desc": "平移视图 y+",
          "raw": "funckey Down \"roam y $roamInc\"",
          "source": "default"
        },
        {
          "key": "F2",
          "desc": "缩放全图",
          "raw": "alias F2 zoom fit",
          "source": "default"
        },
        {
          "key": "F5",
          "desc": "重绘屏幕",
          "raw": "alias F5 redraw",
          "source": "default"
        },
        {
          "key": "F10",
          "desc": "栅格开关",
          "raw": "alias F10 grid toggle",
          "source": "default"
        },
        {
          "key": "F11",
          "desc": "放大",
          "raw": "alias F11 zoom in",
          "source": "default"
        },
        {
          "key": "F12",
          "desc": "缩小",
          "raw": "alias F12 zoom out",
          "source": "default"
        },
        {
          "key": "PageUp",
          "desc": "上一层",
          "raw": "alias Pgup \"layer up\"",
          "source": "default"
        },
        {
          "key": "Ctrl+F5",
          "desc": "颜色面板",
          "raw": "alias CF5 color192",
          "source": "default"
        },
        {
          "key": "PageDown",
          "desc": "下一层",
          "raw": "alias Pgdown \"layer down\"",
          "source": "default"
        },
        {
          "key": "Shift+F11",
          "desc": "上一视图",
          "raw": "alias SF11 zoom previous",
          "source": "default"
        },
        {
          "key": "Shift+F12",
          "desc": "全宇宙视图",
          "raw": "alias SF12 zoom world",
          "source": "default"
        }
      ]
    },
    {
      "name": "编辑",
      "pinned": false,
      "items": [
        {
          "key": "F8",
          "desc": "撤销上一步",
